RewriteEngine On

# Web app manifest needs its own MIME type for install prompts.
AddType application/manifest+json .webmanifest

# Branded error pages (generated by scripts/generate-error-pages.js).
# Local paths keep the original HTTP status code in the response.
ErrorDocument 400 /errors/400.html
ErrorDocument 401 /errors/401.html
ErrorDocument 403 /errors/403.html
ErrorDocument 404 /errors/404.html
ErrorDocument 405 /errors/405.html
ErrorDocument 408 /errors/408.html
ErrorDocument 410 /errors/410.html
ErrorDocument 429 /errors/429.html
ErrorDocument 500 /errors/500.html
ErrorDocument 502 /errors/502.html
ErrorDocument 503 /errors/503.html
ErrorDocument 504 /errors/504.html

# Error pages are never indexed or cached as real content.
<IfModule mod_headers.c>
  <FilesMatch "^[0-9]{3}\.html$">
    Header set X-Robots-Tag "noindex, nofollow"
    Header set Cache-Control "no-store"
  </FilesMatch>
</IfModule>

# Pre-rendered SEO pages for each app route.
RewriteRule ^(about|products|projects|portfolio|services|careers|contact|privacy-policy|cookie-policy|terms)/?$ $1.html [L]

# Serve real files and directories as-is.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Anything else is not a page on this site: return a real 404 (with the
# branded page above) instead of the homepage, which search engines treat
# as a "soft 404" duplicate.
RewriteRule ^ - [R=404,L]
